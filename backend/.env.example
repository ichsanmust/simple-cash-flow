# Koneksi Database (MySQL / SQLite)
DATABASE_URL=mysql+pymysql://user:password@localhost:3306/cashflow
# Contoh SQLite jika tanpa MySQL: sqlite:///./cashflow.db

# Keamanan JWT Auth (Ganti dengan string acak dan rahasia!)
JWT_SECRET=ganti-dengan-string-acak-yang-panjang-dan-rahasia
JWT_EXPIRE_HOURS=24

# Pengaturan Tambahan (Opsional, bawaan sistem sudah mengelola via database/UI)
# OPENROUTER_API_KEY=sk-or-v1-xxxx
# AI_DAILY_LIMIT_PER_USER=20
# MAX_UPLOAD_MB=5
